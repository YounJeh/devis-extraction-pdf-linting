# Force un seul fournisseur et court-circuite la chaîne de bascule
# automatique (app/config/providers.config.json#ocrOrder/extractionOrder) —
# utile pour déboguer un fournisseur précis. Vide = chaîne automatique.
OCR_PROVIDER=
EXTRACTION_PROVIDER=

# Clé API Mistral (OCR — https://console.mistral.ai).
MISTRAL_API_KEY=

# Clé API Groq (extraction — https://console.groq.com).
GROQ_API_KEY=

# Clé API Gemini (extraction des gros documents — https://aistudio.google.com).
GEMINI_API_KEY=

# Clé API OpenRouter (OCR + extraction — https://openrouter.ai/settings/keys).
OPENROUTER_API_KEY=

# Clé API Z.ai (OCR + extraction — https://z.ai/manage-apikey/apikey-list).
ZAI_API_KEY=

# Cloudflare Workers AI (OCR + extraction) : jeton API avec la permission
# "Workers AI - Edit" (https://dash.cloudflare.com/profile/api-tokens) et
# l'identifiant du compte Cloudflare (visible dans l'URL du dashboard ou
# via `wrangler whoami`).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Token Vercel personnel (déploiement via la CLI — vercel.com/account/tokens).
# Utilisé par la CLI `vercel`, pas par le code de l'application.
VERCEL_TOKEN=

# Tracing Langfuse (optionnel — absent = pas de tracing, NoOpTracer utilisé).
# Mêmes clés que le projet Langfuse Cloud du pipeline Python (.env racine).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Vide = https://cloud.langfuse.com (région EU) par défaut du SDK.
# Région US : https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
